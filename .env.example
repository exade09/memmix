# Optional. The scanner runs without it. Logical Mix uses it server-side only.
OPENAI_API_KEY=
OPENAI_RESPONSES_MODEL=gpt-5.5
OPENAI_MIX_TIMEOUT_SECONDS=25
# MIX_RATE_LIMIT=10
# MIX_RATE_WINDOW_SECONDS=600
# MIX_COOLDOWN_SECONDS=8
# Any random string. Signs avatar job tokens; without it, avatar
# generation is unavailable even with a WaveSpeed key.
FONS_JOB_HMAC=
# Older names, still accepted so a live deployment does not break.
# MIXBORN_JOB_HMAC=
# JOB_TOKEN_HMAC_SECRET=
# AVATAR_RATE_LIMIT=6
# AVATAR_RATE_WINDOW_SECONDS=600
# AVATAR_COOLDOWN_SECONDS=8
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=medium

# Used by /hybrid.html and /api/hybrid-image.
WAVESPEED_API_KEY=
# Optional fallback list. If set, this is used before WAVESPEED_API_KEY.
WAVESPEED_API_KEYS=
# FONS avatar model. Defaults to google/nano-banana-2/edit (currently from
# $0.070 per run; the live WaveSpeed estimate is authoritative).
# WAVESPEED_AVATAR_MODEL=google/nano-banana-2/edit
# Legacy /api/hybrid-image override. It does not change the FONS avatar model.
# WAVESPEED_MODEL=
WAVESPEED_IMAGE_SIZE=1024*1024
# Native Nano Banana output tier. 1k is the intended quality/cost balance for
# square token avatars; 2k costs more and is downscaled by the product anyway.
WAVESPEED_IMAGE_RESOLUTION=1k
WAVESPEED_TIMEOUT_SECONDS=120
WAVESPEED_SYNC_MODE=true
WAVESPEED_POLL_INTERVAL_SECONDS=1.0

# Server-only metadata pinning. Never prefix PINATA_JWT with VITE_ or NEXT_PUBLIC_.
PINATA_JWT=
PINATA_GATEWAY_HOST=
PUBLIC_IPFS_GATEWAY=
PINATA_TIMEOUT_SECONDS=20
CANONICAL_SITE_URL=
INITIAL_BUY_MAX_ETH=0.5
# METADATA_RATE_LIMIT=6
# METADATA_RATE_WINDOW_SECONDS=600
# METADATA_COOLDOWN_SECONDS=8

# Server-only Robinhood Chain settings. Never prefix these with VITE_.
# Mainnet (4663) by default: it is the only published RPC. Launching never
# auto-enables and is impossible without a launchpad address.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_EXPLORER_URL=https://robinhoodchain.blockscout.com
# ROBINHOOD_CHAIN_ID=4663
# ROBINHOOD_TESTNET=true
# Pons v2 launch factory. Defaults to the verified live deployment
# (0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e); set only to override it.
# PONS_FACTORY_ADDRESS=
# Both default to true. Set either to false to switch launching off.
ENABLE_NATIVE_LAUNCH=true
ENABLE_MAINNET_LAUNCH=true
# ALLOWED_ORIGINS=https://fons.example
# The RPC proxy carries reads only; eth_sendRawTransaction is not allowlisted.

# Header CA badge admin (/admin/ca). Server-only, never VITE_.
# Password for the admin form. Without it, /admin/ca refuses every save.
ADMIN_CA_PASSWORD=
# A GitHub PAT scoped to Contents: read/write on GITHUB_REPO. Required in
# production only: Vercel's filesystem is rebuilt from git on every deploy,
# so a save there commits data/ca.json and lets the resulting push redeploy
# it, taking about a minute to go live. In local dev (`main.py web`) a save
# writes the file directly and this token is not needed.
GITHUB_TOKEN=
# GITHUB_REPO=exade09/memmix

# FONS public frontend flags (used by the Vite build; not secrets).
# VITE_CANONICAL_URL=
# VITE_ROBINHOOD_TESTNET=true
# VITE_PONS_FACTORY_ADDRESS=
# VITE_ENABLE_AI_TEXT=true
# VITE_ENABLE_AI_IMAGE=true
# VITE_ENABLE_NATIVE_LAUNCH=false
# VITE_ENABLE_MAINNET_LAUNCH=false
# VITE_PLATFORM_TOKEN_ADDRESS=
# VITE_INITIAL_BUY_MAX_ETH=0.5
