# Optional. The scanner runs without it. Logical Mix uses it server-side only.
OPENAI_API_KEY=
OPENAI_RESPONSES_MODEL=gpt-5.5
OPENAI_MIX_TIMEOUT_SECONDS=25
# MIX_RATE_LIMIT=10
# MIX_RATE_WINDOW_SECONDS=600
# MIX_COOLDOWN_SECONDS=8
MIXBORN_JOB_HMAC=
JOB_TOKEN_HMAC_SECRET=
# AVATAR_RATE_LIMIT=6
# AVATAR_RATE_WINDOW_SECONDS=600
# AVATAR_COOLDOWN_SECONDS=8
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=medium

# Used by /hybrid.html and /api/hybrid-image.
WAVESPEED_API_KEY=
# Optional fallback list. If set, this is used before WAVESPEED_API_KEY.
WAVESPEED_API_KEYS=
WAVESPEED_IMAGE_SIZE=1024*1024
WAVESPEED_TIMEOUT_SECONDS=120
WAVESPEED_SYNC_MODE=true
WAVESPEED_POLL_INTERVAL_SECONDS=1.0

# Server-only metadata pinning. Never prefix PINATA_JWT with VITE_ or NEXT_PUBLIC_.
PINATA_JWT=
PINATA_GATEWAY_HOST=
PUBLIC_IPFS_GATEWAY=
PINATA_TIMEOUT_SECONDS=20
CANONICAL_SITE_URL=
INITIAL_BUY_MAX_SOL=5
# METADATA_RATE_LIMIT=6
# METADATA_RATE_WINDOW_SECONDS=600
# METADATA_COOLDOWN_SECONDS=8

# Server-only Solana RPC and native launch flags. Never prefix these with VITE_.
# Default cluster is devnet. Mainnet launch never auto-enables.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
ENABLE_NATIVE_LAUNCH=false
ENABLE_MAINNET_LAUNCH=false
# ALLOWED_ORIGINS=https://mixborn.example
# RPC_SEND_RATE_LIMIT is fixed in code; CI must not send live transactions.

# MIXBORN public frontend flags (used by the Vite build; not secrets).
# VITE_CANONICAL_URL=
# VITE_SOLANA_CLUSTER=devnet
# VITE_ENABLE_AI_TEXT=true
# VITE_ENABLE_AI_IMAGE=true
# VITE_ENABLE_NATIVE_LAUNCH=false
# VITE_ENABLE_MAINNET_LAUNCH=false
# VITE_ENABLE_BAGS_INTENT_FALLBACK=false
# VITE_PLATFORM_TOKEN_MINT=
# VITE_INITIAL_BUY_MAX_SOL=5
